#Method: hashmap + collections.defaultdict(OrderedDict)

from collections import defaultdict, OrderedDict

class LFUCache:

    def __init__(self, capacity: int):
        self.key_to_val_freq = {}  #key -> [value, freq]
        self.capacity = capacity
        self.min_freq = 0
        self.freq_to_keys = defaultdict(OrderedDict)  #freq -> OrderedDict(key -> None)
    def _update_freq(self, key: int):
        val, freq = self.key_to_val_freq[key]

        #Remove key from current frequency list 
        del self.freq_to_keys[key]
        if not self.freq_to_keys[freq]:
            del self.freq_to_keys[freq]
            if self.min_freq == freq:
                self.min_freq += 1

        # Move key to new frequency list
        new_freq = freq +1
        self.key_to_val_freq[key][1] = new_freq
        self.freq_to_keys[new_freq][key] = None

    def get(self, key: int) -> int:
        if key not in self.key_to_val_freq:
            return -1
        self._update_freq(key)
        return self.key_to_val_freq[key][0]

    def put(self, key: int, value: int) -> None:
        if self.capacity == 0:
            return

        if key in self.key_to_val_freq:
            self.key_to_val_freq[key][0] = value
            self._update_freq(key)
        else:
            #Evict LFU item if capacity reached
            if len(self.key_to_val_freq) >= self.capacity:
                evict_key, _ = self.freq_to_keys[self.min_freq].popitems(last=False)
                del self.key_to_val_freq[evict_key]

            # Insert new key
            self.key_to_val_freq[key] = [value, 1]
            self.freq_to_keys[1][key] = None
            self.min_freq = 1


TC: O(1)
SC: O(N) which N is capacity

