class _TrieNode:
    """前缀树中的单个节点。"""
    def __init__(self) -> None:
        self.children: dict[str, "_TrieNode"] = {}
        self.is_end: bool = False


class Trie:
    """前缀树（字典树），支持单词插入、完整单词查找和前缀匹配。"""

    def __init__(self):
        # 创建不存储具体字符的虚拟根节点作为所有路径的起点
        self.root = _TrieNode()

