#Method 1: Expand Around Center
class Solution:
    def longestPalindrome(self, s: str) -> str:
        if not s:
            return ""

        res = ""

        #build helper function:
        def expand(left, right):
            while left >= 0 and right < len(s) and s[left] == s[right]:
                left -= 1
                right += 1
            return s[left+1:right]

        #iterate through each index i from 0 ~ n-1
        for i in range(len(s))
            p1 = expand(i, i)
            p2 = expand(i, i+1)
            res = max(res, p1, p2, key=len)

        return res

TC: O(n*n) #2n-1
SC: O(1)   #only tracking pointers/indices

