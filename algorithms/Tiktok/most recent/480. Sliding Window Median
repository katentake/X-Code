#Method: 有序列表 sortedList

from sortedcontainers import SortedList 
class Solution:
    def medianSlidingWindow(self, nums: List[int], k: int) -> List[int]:
        sliding_window = sortedList(nums[:k]) #建立第一个滑动窗口的有序状态
        res = []

        def get_median(): #定义中位数计算辅助函数
            if k % 2 == 1: #如果窗口大小 $k$ 是奇数
                return float(sliding_window[k // 2])
            return (sliding_window[k // 2 - 1] + sliding_window[k // 2]) / 2.0

        res.append(get_median()) #计算第一个窗口的中位数

        for i in range(k, len(nums)):         #从索引 k 开始遍历数组直到末尾. nums[i] 是新进入窗口的元素，而 nums[i - k] 是离开窗口的元素。
            sliding_window.add(nums[i])       #TC: # O(log k)
            sliding_window.remove(nums[i-k])  #从 SortedList 中移除滑出窗口的旧元素 nums[i - k]  #TC: # O(log k)
            res.append(get_median)     #重新计算当前窗口的中位数并追加到 res 中


        return res 


TC: O(n log k)
SC: O(k)

##返回整数的情况
from typing import List
from sortedcontainers import SortedList

class Solution:
    def medianSlidingWindow(self, nums: List[int], k: int) -> List[int]:
        window = SortedList()
        res = []
        
        for i in range(len(nums)):
            # 1. 元素入窗
            window.add(nums[i])
            
            # 2. 元素出窗
            if i >= k:
                window.remove(nums[i - k])
            
            # 3. 计算并保存当前窗口的中位数（整型）
            if i >= k - 1:
                if k % 2 == 1:
                    res.append(window[k // 2])
                else:
                    # 使用 // 2 进行整除，确保结果为整数
                    res.append((window[k // 2 - 1] + window[k // 2]) // 2)
                    
        return res


TC: O(n log k)
SC: O(k)

from typing import List
import bisect

class Solution:
    def sliding_window(self, nums: List[int], k: int) -> List[int]:
        # 维护一个有序列表 window
        window = []
        res = []
        
        for i in range(len(nums)):
            # 1. 二分插入保持数组有序
            bisect.insort(window, nums[i])
            
            # 2. 移除移出窗口的元素
            if i >= k:   #当元素个数达到 k+1 时弹出最左边的旧元素
                # 使用 remove 移除旧值
                window.remove(nums[i - k])
            
            # 3. 计算中位数, 索引是从 0 开始算的，所以前 k 个元素对应的索引范围是 0 到 k - 1
            if i >= k - 1:  #窗口元素达到了 k 个
                if k % 2 == 1:  #奇数时
                    res.append(window[k // 2])   #找到当前有序窗口中最中间的那个元素，并把它加入到结果列表 res 中
                else:  #偶数时
                    res.append((window[k // 2 - 1] + window[k // 2]) // 2)  #偶数长度的中位数等于 这两个中间元素的平均值
                    
        return res

