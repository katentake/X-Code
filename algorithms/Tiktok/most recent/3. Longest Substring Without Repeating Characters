class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:
        left = 0
        unique_hashset = set()
        max_len = 0

        for right in range(len(s)):
            while s[right] not in unique_hashset:
                unique_hashset.add(s[right])
                right += 1
            max_len = (max_len, len(unique_hashset))

            unique_hashset.remove(s[left])
            left += 1

        return max_len
        

TC: o(n)
SC: O(min(m,n))