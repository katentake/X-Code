#Method: two pointer

class Solution:
    def validWordAbbr(self, word: str, abbr: str) -> bool:
        i = j = 0
        m, n = len(word), len(abbr)

        while i < m and j < n:
            # 如果 abbr 当前字符是数字
            if abbr[j].isdigit():
                # 检查前导零：如果数字以 '0' 开头，则是非法的
                if abbr[j] == 0:
                    return False
            
                # 计算连续的完整数字
                num = 0
                while j < n and abbr[j].isdigit():
                    num = num*10 + int(abbr[j])
                    j += 1
                # word 指针根据数字向前跳过
                i += num
            else:
                # 如果是字母，必须和 word 当前字符严格相等
                if word[i] != abbr[j]:
                    return False
                i += 1
                j += 1

        # 只有当两个指针都刚好遍历完各自的字符串时，才返回 True
        return i == m and j == n

TC: O(N)
SC: O(1)



