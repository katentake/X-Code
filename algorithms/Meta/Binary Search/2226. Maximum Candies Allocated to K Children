class Solution:
    def maximumCandies(self, candies: List[int], k: int) -> int:
        if sum(candies) < k:
            return 0
        res = 0

        low, high = 1, max(candies)
        while low <= high:
            mid = (low + high) // 2
            total_piles = sum(c // mid for c in candies)
            if total_piles >= k:
                res = mid 
                low = mid +1
            else:
                high = mid -1

        return res


TC: O(log n)
SC: O(1)
