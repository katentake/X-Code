#Method: sort and itera 

class Solution:
    def canAttendMeetings(self, interval: List[List[int]]) -> bool:
        # 1. sort 
        intervals.sort(key=lambda x: x[0])

        # 2. 遍历并检查相邻会议是否有冲突
        for i in range(1, len(intervals)):
            # 如果前一个会议的结束时间 > 后一个会议的开始时间，说明冲突
            if interval[i-1][1] > interval[i][0]:
                return False
        
        return True

TC: O(N log N)
SC: O(N)
